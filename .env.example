# Copia este fichero a .env (en esta misma carpeta) y ajusta lo que haga falta.
# docker-compose lo lee automáticamente. .env NO se sube al repositorio.

# --- Base de datos ----------------------------------------------------------
POSTGRES_USER=urbanflow
POSTGRES_PASSWORD=urbanflow
POSTGRES_DB=urbanflow

# --- Autenticación ----------------------------------------------------------
# dev      → decodifica el token SIN comprobar la firma. Solo para local.
#            Permite trabajar con los tokens reales de Firebase Auth que emite
#            el navegador sin tener todavía la clave de servicio del proyecto.
# firebase → verifica de verdad con firebase-admin. Requiere una clave de
#            servicio en backend/secrets/ y GOOGLE_APPLICATION_CREDENTIALS
#            apuntando a ella.
AUTH_MODE=dev

# Correos que reciben rol de administrador la primera vez que entran.
# Sin al menos uno, nadie puede usar /api/admin/* ni borrar spots.
# Pon aquí la cuenta de Google con la que inicies sesión en la app.
ADMIN_EMAILS=amoyap.dev@gmail.com

# Orígenes autorizados para llamar a la API desde el navegador.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Solo para AUTH_MODE=firebase -------------------------------------------
FIREBASE_PROJECT_ID=urbanflow-a0b95
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/serviceAccountKey.json
