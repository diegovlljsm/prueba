# Plantilla de variables de espotealo. Copia a .env.local y rellena.
# .env.local no se versiona.
# Tras cambiar cualquier valor hay que reiniciar `npm run dev`: se leen al
# arrancar, no en caliente.

# --- Mapas y rutas ----------------------------------------------------------
# Clave de la Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=

# OpenRouteService: calcula las rutas de "Cómo llegar". Es gratis y sin tarjeta
# (https://openrouteservice.org/dev/#/signup). Se eligió en vez de Google
# Directions porque esa API exige tener billing habilitado.
VITE_ORS_API_KEY=

# --- Firebase (cliente) -----------------------------------------------------
# Si se dejan vacías, el código cae a firebase-applet-config.json, que apunta
# al proyecto viejo de AI Studio. Se copian de:
#   Firebase → Configuración del proyecto → Tus apps → app web → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Id de la base de Firestore. Déjalo VACÍO si el proyecto usa la base
# `(default)`, que es lo normal. Solo el proyecto de AI Studio usa una base con
# nombre. Poner aquí un id que no existe hace que todas las consultas fallen en
# silencio y el servidor caiga al almacén en memoria.
VITE_FIRESTORE_DATABASE_ID=

# --- Firebase (servidor) ----------------------------------------------------
# Deben coincidir con las del cliente.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=

# Clave de cuenta de servicio, la que hace que los datos PERSISTAN de verdad.
# Sin ella el servidor arranca igual, pero guarda en memoria y todo lo que cree
# un usuario se pierde al reiniciar.
#
# Se descarga en:
#   Firebase → Configuración del proyecto → Cuentas de servicio
#   → "Generar nueva clave privada"
# Guárdala en secrets/serviceAccountKey.json (esa carpeta está en .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json
