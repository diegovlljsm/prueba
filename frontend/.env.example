# Plantilla de variables del frontend. Cópiala a .env.local y rellénala.
# .env.local no se versiona.

# --- Google Maps ------------------------------------------------------------
# Clave de la Maps JavaScript API, del mismo proyecto de Google Cloud que
# Firebase. Hay que habilitar DOS APIs en ese proyecto:
#   · Maps JavaScript API  → dibuja el mapa
#   · Directions API       → calcula "Cómo llegar" y los tramos paso a paso
# Restringe la clave por referente HTTP antes de compartirla: viaja en el
# bundle del navegador.
VITE_GOOGLE_MAPS_API_KEY=

# --- Firebase ---------------------------------------------------------------
# Config web del proyecto. Se copia de Firebase → Configuración del proyecto
# → Tus apps → app web → Configuración del SDK.
# Si se dejan vacías, el código cae al firebase-applet-config.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Backend ----------------------------------------------------------------
# A dónde apunta el proxy /api de Vite.
API_URL=http://localhost:8080
